# BRIDGE DO BROKER PÚBLICO
# ------------------------------------------------------------

user mqtt_bridge_public

# Lê os dados publicados pelos dispositivos
topic read hidrocontrol/v1/devices/+/telemetry
topic read hidrocontrol/v1/devices/+/status
topic read hidrocontrol/v1/devices/+/event
topic read hidrocontrol/v1/devices/+/availability

# Publica comandos recebidos do ambiente privado
topic write hidrocontrol/v1/devices/+/command
topic write hidrocontrol/v1/devices/+/config


# ------------------------------------------------------------
# ADMINISTRAÇÃO E TESTES
